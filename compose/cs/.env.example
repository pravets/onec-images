# Переменные стека 1С:Сервера взаимодействия (compose/cs/compose.yaml).
# Скопируйте в .env и замените все значения на свои:
#   cp .env.example .env
#
# ВАЖНО: значения ниже — примеры для быстрого старта. Перед промышленной
# эксплуатацией смените пароли (требование руководства по установке).

# ---------------------------------------------------------------------------
# Образы
# ---------------------------------------------------------------------------
# Префикс реестра; для локальных сборок оставьте пустым или укажите library/
CS_IMAGE_REGISTRY=
CS_VERSION=30.0.42

# ---------------------------------------------------------------------------
# PostgreSQL 15 — ВСЕГДА внешняя.
# Перед первым запуском создайте пользователя, БД и расширение:
#   CREATE USER db_user WITH PASSWORD 'db_user_pwd' CREATEDB;
#   CREATE DATABASE cs_db OWNER db_user;
#   \c cs_db
#   CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
# Для промышленной эксплуатации рекомендуется сборка PostgreSQL с патчами 1С
# (releases.1c.ru/project/AddCompPostgre).
# ---------------------------------------------------------------------------
CS_DB_URL=jdbc:postgresql://postgres.example.com:5432/cs_db?currentSchema=public
CS_DB_USER=db_user
CS_DB_PASSWORD=db_user_pwd

# ---------------------------------------------------------------------------
# Административный REST CS (порт 8087) и учётная запись администратора.
# Пароль admin/admin из коробки НЕДОПУСТИМ в промышленной эксплуатации.
# ---------------------------------------------------------------------------
CS_ADMIN_USER=admin
CS_ADMIN_PASSWORD=CHANGE_ME_admin_password
CS_ADMIN_PORT=8087
CS_ADMIN_HOST_PORT=8087

# ---------------------------------------------------------------------------
# WebSocket для клиентов 1С. Адрес, который вводится в обработке
# CollaborationSystemRegister.epf: ws://<host>:<порт> или wss://<host>.
# ---------------------------------------------------------------------------
CS_WS_PORT=8086
CS_WS_HOST_PORT=8086
CS_WS_WSS=false

# ---------------------------------------------------------------------------
# Hazelcast. Оставьте адрес hazelcast, чтобы использовать контейнер из стека;
# укажите внешний адрес (или список через запятую), чтобы использовать внешний
# кластер. Имя группы и пароль должны совпадать у Hazelcast и у CS.
# ---------------------------------------------------------------------------
CS_HAZELCAST_ADDRESSES=hazelcast
CS_HAZELCAST_GROUP_NAME=1ce-cs
CS_HAZELCAST_GROUP_PASSWORD=cs-pass
# Участники кластера для многоузлового режима (разрешимые имена или IP):
# CS_HAZELCAST_MEMBERS=10.0.0.11,10.0.0.12

# ---------------------------------------------------------------------------
# Elasticsearch. Адрес указывается с ТРАНСПОРТНЫМ портом 9300.
# elasticsearch — контейнер стека; для внешнего кластера задайте свой адрес.
# ---------------------------------------------------------------------------
CS_ES_ADDRESSES=elasticsearch:9300
CS_ES_CLUSTER_NAME=1ce-cs
CS_ES_NODE_NAME=node-1
CS_ES_HEAP=1g
# CS_ES_DISCOVERY_HOSTS=10.0.0.21:9300,10.0.0.22:9300

# ---------------------------------------------------------------------------
# Публичные адреса. CS_PUBLIC_URL — адрес сайта внешних пользователей,
# CS_INTEGRATION_PUBLIC_URL — адрес, по которому интеграции достучатся до CS.
# ---------------------------------------------------------------------------
CS_PUBLIC_URL=https://cs.example.com
CS_INTEGRATION_PUBLIC_URL=https://cs.example.com
CS_INTEGRATION_PORT=8443
CS_INTEGRATION_HOST_PORT=8443
CS_CONFERENCE_HOST_PORT=8444

# ---------------------------------------------------------------------------
# Видеосвязь: подключается ВНЕШНИЙ медиасервер Janus.
# Пустое CS_MEDIA_SERVER_URL — видеосвязь не подключается.
# После первого подключения Janus выполните в CS переиндексацию (см. README).
# ---------------------------------------------------------------------------
CS_VIDEO_ENABLED=false
CS_MEDIA_SERVER_URL=
CS_MEDIA_SERVER_NAME=Janus 1
CS_MEDIA_CONFEREE_LIMIT=1000

# TURN/STUN (внешний coturn) для медиасоединений через NAT и межсетевые экраны
CS_TURN_URL=
CS_TURN_USER=
CS_TURN_PASSWORD=

# ---------------------------------------------------------------------------
# S3-хранилище файлов.
# Вариант «встроенное» (RustFS): docker compose --profile s3 up -d, тогда
#   CS_S3_ENDPOINT=http://rustfs:9000
#   CS_S3_ACCESS_KEY=rustfs, CS_S3_SECRET_KEY=<секрет>
# Бакет создаётся один раз в консоли RustFS (http://<хост>:9001) или любым
# S3-клиентом — как и требует руководство 1С (раздел 9.2).
# Вариант «внешнее» (в т.ч. S3 без поддержки path-style):
#   CS_S3_ENDPOINT=https://s3.example.com
# CS_S3_ENDPOINT не должен указывать на localhost: клиенты обращаются к
# хранилищу напрямую (руководство, раздел 9.3).
# ---------------------------------------------------------------------------
CS_S3_ENDPOINT=
CS_S3_BUCKET=cs-bucket
CS_S3_ACCESS_KEY=rustfs
CS_S3_SECRET_KEY=rustfs12345
CS_S3_REGION=eu-west-1
# RustFS работает по AWS Signature V4. Для внешних S3-совместимых хранилищ
# укажите ту версию подписи, которую они требуют (руководство 1С показывает V2
# для MinIO).
CS_S3_SIGNATURE_VERSION=V4

# ---------------------------------------------------------------------------
# Сайт внешних пользователей и web-chat (профиль site).
# CS_PUBLIC_WS_URL — адрес CS, который увидит браузер внешнего пользователя.
# CS_VAPID_PUBLIC_KEY — публичный ключ Web Push (выдаёт CS), пусто — без push.
# ---------------------------------------------------------------------------
CS_PUBLIC_WS_URL=wss://cs.example.com
CS_VAPID_PUBLIC_KEY=
CS_SITE_HOST_PORT=8081
CS_WEB_CHAT_HOST_PORT=8082

# ---------------------------------------------------------------------------
# RustFS — встроенное S3-хранилище (профиль s3).
# Образ можно заменить на свой зеркальный/закреплённый по версии.
# ---------------------------------------------------------------------------
RUSTFS_IMAGE=rustfs/rustfs:latest
RUSTFS_LOG_LEVEL=error
RUSTFS_API_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001

# ---------------------------------------------------------------------------
# Регистрация зависимостей (сервис init).
# once — один раз (маркер в томе server-data), always — при каждом запуске,
# never — не регистрировать автоматически.
# ---------------------------------------------------------------------------
CS_BOOTSTRAP=once
CS_BOOTSTRAP_STRICT=false

# ---------------------------------------------------------------------------
# Логи CS (в добавок к файлам экземпляра выводятся в docker logs)
# ---------------------------------------------------------------------------
CS_LOG_CONSOLE=true
CS_LOG_LEVEL=WARN
